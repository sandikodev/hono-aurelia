{
  "name": "@hono/aurelia",
  "version": "1.0.0-alpha.1",
  "description": "Server-side rendering adapter for Aurelia 2 on Hono",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./build": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "default": "./dist/builder.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -w --preserveWatchOutput",
    "build": "tsc",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "aurelia",
    "hono",
    "ssr",
    "server-side-rendering",
    "fullstack"
  ],
  "author": "Sandikodev <androxoss@hotmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "aurelia": "^2.0.0-rc.2",
    "hono": "^4.0.0"
  },
  "dependencies": {
    "@aureliajs/ssr": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "aurelia": "^2.0.0-rc.2",
    "bun-types": "^1.4.4",
    "hono": "^4.0.0",
    "typescript": "5.9.3"
  }
}
