{
  "name": "@hono/aurelia-ssr",
  "version": "1.0.0-alpha.1",
  "description": "Server-side rendering adapter for Aurelia 2 on Hono",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "aurelia",
    "hono",
    "ssr",
    "server-side-rendering",
    "fullstack"
  ],
  "author": "Sandikodev <androxoss@hotmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "aurelia": "^2.0.0",
    "hono": "^4.0.0"
  },
  "dependencies": {
    "@aureliajs/ssr": "^0.1.0",
    "jsdom": "^23.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "aurelia": "^2.0.0-rc.2",
    "eslint": "^8.54.0",
    "hono": "^4.0.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  }
}
