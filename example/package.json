{
  "name": "aurelia-ssr-example",
  "version": "0.1.0",
  "description": "Production-ready Canonical Hono + Aurelia 2 SSR Community Scaffold Example",
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --watch src/index.ts",
    "build:client": "bun build src/client.ts --outdir public --loader .html:text --minify",
    "build:worker": "bun -e \"import { buildWorker } from '@hono/aurelia/build'; await buildWorker()\"",
    "build": "bun run build:client && tsc --noEmit",
    "deploy:worker": "wrangler deploy",
    "preview:worker": "wrangler dev",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit --strict",
    "test": "bun test",
    "lint": "bunx oxlint src"
  },
  "dependencies": {
    "@aureliajs/ssr": "workspace:*",
    "@hono/aurelia": "link:..",
    "@hono/node-server": "^1.12.0",
    "aurelia": "^2.0.0-rc.2",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  }
}
