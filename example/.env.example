# Server Configuration
PORT=3000
NODE_ENV=development

# Hono/Aurelia Configuration
LOG_LEVEL=info

# API Configuration (for client-side fetching)
API_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Auth Configuration (demo only)
TELEMETRY_TOKEN=replace-with-a-long-random-value

# Feature Flags
ENABLE_HYDRATION=true
ENABLE_API_ENDPOINTS=true
